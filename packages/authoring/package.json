{
  "name": "@scorm-cli/authoring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Internal authoring marker vocabulary exposed to authors through the public scorm-cli/authoring subpath.",
  "main": "./dist/index.js",
