{
  "name": "scorm-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the public scorm-cli package and its private workspace packages.",
  "scripts": {
    "build": "pnpm --filter scorm-cli... run build",
    "dev": "pnpm --filter scorm-cli... run build && pnpm scorm preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && pnpm -r --if-present run test",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck",
    "scorm": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@9.0.0"
}
