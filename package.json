{
  "name": "scorm-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present --workspace-concurrency=1 run build",
    "dev": "pnpm --filter @scorm-cli/cli dev",
    "test": "pnpm build && pnpm -r --if-present run test",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck",
    "scorm": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.0.0"
}
